# Shared secret for license activation callback HMAC (set to a strong random value in production)
LICENSE_CALLBACK_SECRET=
# LaravelCP Environment Configuration
# -------------------------------------
# TIP: For easy setup, use the web installer at: https://your-domain.com/install
# The installer will configure this file automatically!
# -------------------------------------

APP_NAME=LaravelCP
APP_ENV=local
APP_KEY=base64:placeholder
# ⚠️ PRODUCTION: Set to false — true exposes full stack traces to users
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8002
FRONTEND_URL=http://localhost:5176

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravelcp
DB_USERNAME=laravelcp
DB_PASSWORD=laravelcp

SESSION_DRIVER=database
SESSION_LIFETIME=120
# ⚠️ PRODUCTION: Set to true — encrypts session data at rest
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# ⚠️ PRODUCTION: Use 'redis' for better queue performance
QUEUE_CONNECTION=database

# ⚠️ PRODUCTION: Use 'redis' — database cache bottlenecks under game load
CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# CORS & Sanctum Configuration (IMPORTANT FOR PRODUCTION)
CORS_ALLOWED_ORIGINS=http://localhost:5176
CORS_SUPPORTS_CREDENTIALS=false
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5176

# ⚠️ PRODUCTION: Change to 'smtp' or 'mailgun' — 'log' only writes to storage/logs
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Mailgun Configuration (for production)
# Set MAIL_MAILER=mailgun to use Mailgun
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# BoxingDB scraper automation
# Set enabled=true only after creating tools/boxingdb_scraper/sources.local.json
BOXINGDB_SCRAPER_ENABLED=false
BOXINGDB_SCRAPER_PYTHON=
BOXINGDB_SCRAPER_SOURCES_PATH=tools/boxingdb_scraper/sources.local.json
# daily, hourly, every-six-hours, twice-daily
BOXINGDB_SCRAPER_SCHEDULE=daily
BOXINGDB_SCRAPER_IMPORT=true
BOXINGDB_SCRAPER_REPLACE_EVENT_FIGHTS=false
BOXINGDB_SCRAPER_SAVE_RAW=false
BOXINGDB_SCRAPER_SAVE_SCREENSHOTS=false
BOXINGDB_SCRAPER_TIMEOUT=1800
